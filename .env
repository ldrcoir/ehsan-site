# ============================================================================
# .env — تنظیمات محیط (اصلاح شده)
# ============================================================================

# Database — مسیر نسبی (نه مطلق)
DATABASE_URL="file:./db/custom.db"

# Server
NODE_ENV="development"
PORT=3000
HOSTNAME="0.0.0.0"

# Session secret — حتماً عوض کن!
# تولید: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-random-secret-in-production"

# Optional: AI providers (leave empty for demo mode)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""
