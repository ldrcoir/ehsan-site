node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log

# Dev tooling — not part of the shipped site (v1.1)
/skills/
/.zscripts/
/tests/
/examples/
/mini-services/
worklog.md

# v1.1 (fix): npm is the package manager (Dockerfile/install.sh use npm ci);
# package-lock.json IS tracked now for reproducible installs. bun.lock deleted.
node_modules/
tool-results/
# v1.1: migration/backup archives must never be committed (contain DB + secrets)
*.tar.gz
download/

# Database (v1.1 — critical: contains hashes + admin credentials)
/db/*.db
/db/*.db-journal
/db/*.db-wal
/db/*.db-shm
/db/

# Backups
*.bak
*.bak.*
backups/

# ============================================================================
# Release artifacts (v1.0):
# - zips/docxها هرگز commit نمی‌شوند (v1.0: قوانین negation حذف شدند — یک zip
#   19MB در repo یعنی تاریخچه‌ی متورم دائمی؛ توزیع با GitHub Releases)
# ============================================================================
download/*.zip
public/*.zip

public/TUTORIAL_FA_*.docx
download/TUTORIAL_FA_*.docx

# bun.lock منسق — Dockerfile/package-lock.json مرجع اصلی است (audit W51-55 #2)
bun.lock

__pycache__/
*.pyc

# delivered artifacts (kept out of repo & served build)
/dist/
*.zip
*.docx
__pycache__/

# v1.0 rev2 — بسته‌ی انتشار رسمی داخل ریپو (به درخواست صاحب سایت):
!releases/
!releases/*.zip
