worklog.md

# v1.1 (fix): npm is the package manager (Dockerfile/install.sh use npm ci);
# package-lock.json IS tracked now for reproducible installs. bun.lock deleted.
node_modules/
tool-results/
# v1.1: migration/backup archives must never be committed (contain DB + secrets)
*.tar.gz
download/

# Database (v1.1 — critical: contains hashes + admin credentials)
/db/*.db
/db/*.db-journal
/db/*.db-wal
/db/*.db-shm
/db/

# Backups
*.bak
*.bak.*
backups/

# ============================================================================
# Release artifacts (v1.0):
# - zips/docxها هرگز commit نمی‌شوند (v1.0: قوانین negation حذف شدند — یک zip
#   19MB در repo یعنی تاریخچه‌ی متورم دائمی؛ توزیع با GitHub Releases)
# ============================================================================
download/*.zip
public/*.zip

public/TUTORIAL_FA_*.docx
download/TUTORIAL_FA_*.docx

# bun.lock منسق — Dockerfile/package-lock.json مرجع اصلی است (audit W51-55 #2)
bun.lock

__pycache__/
*.pyc

# delivered artifacts (kept out of repo & served build)
/dist/
*.zip
*.docx
__pycache__/

# v1.0 rev2 — بسته‌ی انتشار رسمی داخل ریپو (به درخواست صاحب سایت):
# v1.0 rev6 — فقط «یک» نسخه‌ی رسمی در ریپو می‌ماند:
#   EMA/deployment/01-UPLOAD-ZIP/  ← تنها محل رسمی zip انتشار
#   (EMA/releases/ از ریپو و از تاریخچه حذف شد — کپی تکراری بود)
!EMA/deployment/
!EMA/deployment/**
!EMA/deployment/**/*.docx
!EMA/deployment/**/*.zip
!EMA/deployment/**/*.txt
!EMA/deployment/**/*.md
# PDFs are auto-generated from docx — do not commit
EMA/deployment/**/*.pdf

# v1.0 rev6 — server-state working dir (snapshot محلی؛ نسخه‌ی رسمی روی branch است)
/server-state/

# v1.0 rev5 — GitHub token (never commit; 600 perms; user-provided for AI push)
.gh-token
.gh-token-*

# Vazirmatn Persian font (فقط برای sandbox، نه برای ریپو)
scripts/fonts/

# credentials کانال AI (هرگز commit نشود)
db/.channel-credentials.env

# اسکریپت بازگردانی توکن — هرگز commit نشود
download/bazgardani-token.sh
