# ============================================================================
# Caddyfile — ۳ دامنه با SSL خودکار (Let's Encrypt) — v1.1
# ============================================================================
# Caddy خودش SSL می‌گیره — نیازی به certbot نیست
# فقط DNS رو به 31.70.76.10 ست کن، بقیه‌ش با Caddy
#
# v1.1 (security pass 2):
#   - header_up X-Real-IP {remote_host} اضافه شد — Caddy به‌طور پیش‌فرض
#     X-Real-IP ست نمی‌کند؛ بدون این، کلاینت می‌توانست X-Real-IP جعلی بفرستد و
#     همه‌ی rate limitها را دور بزند (app از v1.1 خواندن X-Real-IP را هم اعتبارسنجی می‌کند)
#   - هدرهای Strict-Transport-Security و X-Frame-Options از اینجا حذف شدند —
#     app خودش (middleware) نسخه‌ی قوی‌تر را ست می‌کند و Caddy آن‌ها را override می‌کرد
#
# نکته‌ی deployment: «personal-site» فقط داخل شبکه‌ی docker معتبر است. اگر Caddy
# روی خودِ host اجرا می‌شود (کنار docker-compose)، به جای آن بنویسید:
#     reverse_proxy 127.0.0.1:3000
# ============================================================================

# ---------------------------------------------------------------------------
# دامنه ۱: ehsanmorad.ir
# ---------------------------------------------------------------------------
ehsanmorad.ir, www.ehsanmorad.ir {
    reverse_proxy personal-site:3000 {
        header_up X-Real-IP {remote_host}
    }
    encode gzip zstd
    header {
        X-Content-Type-Options "nosniff"
    }
}

# ---------------------------------------------------------------------------
# دامنه ۲: ehsan-morad.ir
# ---------------------------------------------------------------------------
ehsan-morad.ir, www.ehsan-morad.ir {
    reverse_proxy personal-site:3000 {
        header_up X-Real-IP {remote_host}
    }
    encode gzip zstd
    header {
        X-Content-Type-Options "nosniff"
    }
}

# ---------------------------------------------------------------------------
# دامنه ۳: ehsanmorad.id.ir
# ---------------------------------------------------------------------------
ehsanmorad.id.ir, www.ehsanmorad.id.ir {
    reverse_proxy personal-site:3000 {
        header_up X-Real-IP {remote_host}
    }
    encode gzip zstd
    header {
        X-Content-Type-Options "nosniff"
    }
}
